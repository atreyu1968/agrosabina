    "text": "\n<div class=\"shell\">\n  <header class=\"topbar\">\n    <div class=\"topbar-titles\">\n      <h1 id=\"viewTitle\">Resumen</h1>\n      <p id=\"viewSub\">Cargando…</p>\n    </div>\n    <div class=\"topbar-actions\" id=\"topActions\"></div>\n  </header>\n  <main id=\"view\" tabindex=\"-1\"></main>\n</div>\n\n<div id=\"toasts\" class=\"toasts\" aria-live=\"polite\" aria-atomic=\"false\"></div>\n<div id=\"modalRoot\"></div>\n<input id=\"filePicker\" type=\"file\" accept=\"image/*,application/pdf\" multiple hidden>\n<input id=\"cameraPicker\" type=\"file\" accept=\"image/*\" capture=\"environment\" hidden>\n\n<script type=\"module\" src=\"assets/js/main.js\"></script>\n\n<script>\n/* Red de seguridad. Si el navegador no deja arrancar el programa (por ejemplo\n   porque el archivo se abrió con doble clic desde el disco y los módulos\n   quedan bloqueados), avisamos con un mensaje claro en vez de dejar la\n   pantalla vacía. Cuando todo va bien, no se ve nada de esto. */\nwindow.setTimeout(function () {\n  if (window.__appBooted) return;\n  var sub = document.getElementById(\"viewSub\");\n  if (sub) sub.textContent = \"No he podido arrancar\";\n  var view = document.getElementById(\"view\");\n  if (!view) return;\n",
